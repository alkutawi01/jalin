# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/jalin
DATABASE_SSL=false
DATABASE_POOL_SIZE=5

# Content Source (markdown | database)
CONTENT_SOURCE=markdown

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Authentication
# Required in production. Secret token for admin login.
ADMIN_SECRET=your-secret-here

# Comma-separated list of allowed admin emails.
# If empty, all authenticated users with correct password are allowed.
ADMIN_ALLOWED_EMAILS=admin@jalin.adjung.com

# Set to "true" to enable dev bypass (development only).
# Never enable in production.
ADMIN_DEV_BYPASS=true
