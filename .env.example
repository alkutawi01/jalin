# Database Configuration
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SSL=true
DATABASE_POOL_SIZE=5

# Content Source (markdown | database)
CONTENT_SOURCE=markdown

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Authentication
# Required in production. Secret token for admin login.
ADMIN_SECRET=your-secret-here

# Comma-separated list of allowed admin emails.
# If empty, all authenticated users with correct password are allowed.
ADMIN_ALLOWED_EMAILS=admin@jalin.adjung.com

# Set to "true" to enable dev bypass (development only).
# Never enable in production.
ADMIN_DEV_BYPASS=true

# OpenAI (text generation - admin only, never exposed to client)
OPENAI_API_KEY=

# Magnific (visual generation - the ONLY image provider for Jalin, AGENTS.md rule 15)
# Server-side only. Never DB, never client bundle, never API response, never logs.
# Fail closed if unavailable.
MAGNIFIC_API_KEY=
# Official base: https://api.magnific.com (auth header: x-magnific-api-key)
# Optional full endpoint override (defaults to https://api.magnific.com/v1/ai/mystic)
# MAGNIFIC_API_URL=
# HMAC-SHA256 secret for official webhook verification (webhook-id.timestamp.body)
MAGNIFIC_WEBHOOK_SECRET=
# Optional absolute webhook callback URL (defaults to ${NEXT_PUBLIC_APP_URL}/api/webhooks/magnific)
# MAGNIFIC_WEBHOOK_URL=

# Durable object storage for visual assets (S3-compatible).
# REQUIRED in production/Vercel for asset_finalized=true.
# Without this on Vercel, storage fails closed (finalized=false → attach blocked).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=
